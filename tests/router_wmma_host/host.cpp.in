#include "apps/glm_route_levers.hpp"
#include "router_wmma_gate_checks.hpp"
#include <cstdio>
#include <cstring>
#include <limits>
#include <memory>
#include <stdexcept>
#include <string>
#include <vector>

void require(bool value, const char* what) { if (!value) throw std::runtime_error(what); }
unsigned failures = 0;
void check(bool value, const std::string&) { if (!value) ++failures; }
void ok(int value, const char* what) { require(value == 0, what); }
int hipMemset(void* p, int value, std::size_t bytes) { std::memset(p, value, bytes); return 0; }
template <class T> std::vector<T> host(const T* p, std::size_t n) { return {p, p + n}; }
std::vector<void*> allocations;
bool drained = false;
int hipDeviceSynchronize() { drained = true; return 0; }
int hipFree(void* p) {
    check(drained, "drain before free");
    const auto it = std::find(allocations.begin(), allocations.end(), p);
    if (it == allocations.end()) { ++failures; return 1; }
    allocations.erase(it);
    ::operator delete(p);
    return 0;
}
template <class T> T* dalloc(std::size_t n) {
    auto* p = static_cast<T*>(::operator new(n * sizeof(T)));
    allocations.push_back(p);
    drained = false;  // model outstanding conversion/product work
    return p;
}
namespace core::f16_dense_tall { @OWNER@ }
struct Layer {
    @WEIGHT_FIELD@
};
struct Owned {
    Layer y;
    @FLAG_FIELD@
    explicit Owned(unsigned fail) {
        constexpr unsigned kExperts = 2, kHidden = 2, T = 4;
        @WEIGHT_ALLOC@
        if (fail == 1U) throw std::runtime_error("conversion failure");
        @FLAG_ALLOC@
        if (fail == 2U) throw std::runtime_error("flag initialization failure");
    }
};
void ownership() {
    for (unsigned failure : {0U, 1U, 2U, 0U}) {
        try { Owned instance(failure); } catch (const std::runtime_error&) {}
        require(allocations.empty(), "new router allocations leaked on destruction/unwind");
        require(failures == 0, "storage freed before outstanding work drained");
    }
}

namespace gate_fixture {
enum class Candidate { correct, no_stores, exact_only, no_fallback };
constexpr unsigned E = 2, K = 1;
const std::vector<unsigned> big{3U};
constexpr float poison_nan = std::numeric_limits<float>::quiet_NaN();
namespace moe::hip {
constexpr std::size_t router_tiled_scratch_floats(unsigned n) { return std::size_t{n} * 2U * E; }
}
void glm_gate(Candidate candidate, unsigned rows = 4) {
    failures = 0;
    const std::vector<float> ref(rows * E, router_wmma_test::probe_input);
    std::vector<float> output = ref;
    std::vector<std::uint32_t> flag_values(rows, 0U);
    [[maybe_unused]] float* dy = output.data();
    auto* flags = flag_values.data();
    std::vector<float> form[3];
    const auto collect = [&] { return output; };
    const auto wmma = [&](unsigned) {
        if (candidate == Candidate::no_stores) return;
        output = ref;
        if (candidate != Candidate::exact_only)
            for (unsigned r = 0; r < rows - 1U; ++r)
                std::fill_n(output.begin() + r * E, E, 1.0F);
        if (candidate == Candidate::no_fallback) std::fill_n(output.begin() + big[0] * E, E, poison_nan);
    };
    @GLM_LOOP@
    require((failures != 0) == (candidate != Candidate::correct), "GLM gate accepted broken candidate or rejected valid stores");
}
struct Outs { std::vector<float> scores, w; std::vector<std::uint32_t> ids; };
void mm_gate(Candidate candidate, unsigned rows = 4) {
    failures = 0;
    const float exact = 1.0F / (1.0F + std::exp(-router_wmma_test::probe_input));
    const float rounded = 1.0F / (1.0F + std::exp(-1.0F));
    const Outs ref{std::vector<float>(2U * E * rows, exact), std::vector<float>(rows * K, 1.0F), std::vector<std::uint32_t>(rows * K, 0U)};
    Outs output = ref, form[3];
    [[maybe_unused]] float* scratch = output.scores.data();
    [[maybe_unused]] float* dwt = output.w.data();
    [[maybe_unused]] auto* di = output.ids.data();
    std::vector<std::uint32_t> flag_values(rows, 0U);
    auto* flags = flag_values.data();
    const auto collect = [&] { return output; };
    const auto wmma = [&](unsigned) {
        if (candidate == Candidate::no_stores) return;
        output = ref;
        if (candidate != Candidate::exact_only)
            for (unsigned e = 0; e < 2U * E; ++e)
                for (unsigned r = 0; r < rows - 1U; ++r) output.scores[e * rows + r] = rounded;
        if (candidate == Candidate::no_fallback)
            for (unsigned e = 0; e < 2U * E; ++e) output.scores[e * rows + big[0]] = poison_nan;
    };
    @MM_LOOP@
    require((failures != 0) == (candidate != Candidate::correct), "MiniMax gate accepted broken candidate or rejected valid stores");
}
}  // namespace gate_fixture
namespace hello_test { @HELLO@ }
int main(int argc, char** argv) {
    try {
        require(argc >= 2, "test mode required");
        const std::string mode = argv[1];
        if (mode == "ownership") ownership();
        else if (mode == "gates") {
            using namespace gate_fixture;
            for (const auto c : {Candidate::correct, Candidate::no_stores, Candidate::exact_only, Candidate::no_fallback}) {
                glm_gate(c); mm_gate(c);
            }
        } else if (mode == "fingerprint") {
            require(argc == 4, "entry and rank required");
            const auto fp = strix::glm::record_route_levers(argv[2], static_cast<unsigned>(std::stoul(argv[3])), "auto", "exact", "r1", 4096);
            std::printf("%u\n", static_cast<std::uint32_t>(fp ^ (fp >> 32U)));
        } else if (mode == "hello") {
            require(argc == 4, "two fingerprints required");
            hello_test::Hello a, b;
            a.route_fingerprint = static_cast<std::uint32_t>(std::stoul(argv[2]));
            b.route_fingerprint = static_cast<std::uint32_t>(std::stoul(argv[3]));
            require(hello_test::hello_mismatch(a, b).find("route_fingerprint") != std::string::npos, "opposite router policies accepted by HTTP hello");
        } else throw std::runtime_error("unknown test mode");
    } catch (const std::exception& e) { std::fprintf(stderr, "%s\n", e.what()); return 1; }
    return 0;
}
