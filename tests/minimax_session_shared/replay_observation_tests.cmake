cmake_minimum_required(VERSION 3.24)
include("${REPO_ROOT}/cmake/StrixReplayObservation.cmake")
if(DEFINED REJECT_INPUT)
    file(READ "${REJECT_INPUT}" source)
    strix_replay_observe_queue("${source}" observed)
    message(FATAL_ERROR "Negative case was unexpectedly accepted")
endif()
file(MAKE_DIRECTORY "${WORK}")
foreach(kind current archived)
    if(kind STREQUAL "current")
        set(path "${REPO_ROOT}/src/serve/engine.cpp")
        set(sites 1)
    else()
        set(path "${ARCHIVED_ROOT}/src/serve/engine.cpp")
        set(sites 1)
    endif()
    file(READ "${path}" source)
    strix_replay_observe_queue("${source}" observed)
    foreach(hook "    minimax_replay_submitted();" "    minimax_replay_tokens(ticket.get(), tokens);")
        strix_replay_count("${observed}" "${hook}" count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "${kind}: expected exactly one observer call: ${hook}")
        endif()
    endforeach()
    strix_replay_count("${observed}" "minimax_replay_publish(ticket, tokens)" count)
    if(NOT count EQUAL sites)
        message(FATAL_ERROR "${kind}: publication call count changed")
    endif()
    # Undo ONLY our declared edits, proving every other byte (live parser,
    # expression/order, queue storage and scheduling included) was preserved.
    string(FIND "${observed}" "#include \"strix/serve/short_first.hpp\"" start)
    if(start EQUAL -1)
        message(FATAL_ERROR "${kind}: original include boundary missing")
    endif()
    string(SUBSTRING "${observed}" ${start} -1 restored)
    string(REPLACE "minimax_replay_publish(ticket, tokens)" "ticket->publish(tokens)" restored "${restored}")
    string(REPLACE "    minimax_replay_submitted();\n" "" restored "${restored}")
    string(REPLACE "GenerationQueue::test_now()" "std::chrono::steady_clock::now()" restored "${restored}")
    if(NOT restored STREQUAL source)
        message(FATAL_ERROR "${kind}: transform changed undeclared source bytes")
    endif()
    foreach(mutation missing changed duplicate submission reinstrumented)
        set(bad "${source}")
        if(mutation STREQUAL "missing")
            string(REPLACE "ticket->publish(tokens)" "ticket->publish(other)" bad "${bad}")
        elseif(mutation STREQUAL "changed")
            string(REPLACE "return ticket->publish(tokens)" "return keep && ticket->publish(tokens)" bad "${bad}")
        elseif(mutation STREQUAL "duplicate")
            string(APPEND bad "\nreturn ticket->publish(tokens);\n")
        elseif(mutation STREQUAL "submission")
            string(REPLACE "ready_.notify_one();\n    return ticket;" "return ticket;" bad "${bad}")
        else()
            set(bad "${observed}")
        endif()
        set(input "${WORK}/${kind}-${mutation}.cpp")
        file(WRITE "${input}" "${bad}")
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DREPO_ROOT=${REPO_ROOT}"
            "-DREJECT_INPUT=${input}" -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
        file(WRITE "${WORK}/${kind}-${mutation}.log" "${output}${error}")
        if(status EQUAL 0 OR NOT error MATCHES "Replay (observation seam changed|queue is already instrumented)")
            message(FATAL_ERROR "${kind}/${mutation}: did not fail closed at transform: ${error}")
        endif()
    endforeach()
endforeach()
message(STATUS "Actual current and archived queues: byte-preserving transform, one hook each, ten rejected mutations")
