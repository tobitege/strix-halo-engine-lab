# Extract once from a separately archived task-entry source. Never from current
# production, and never regenerate a capture as part of an ordinary test run.
if(CHECK_FAILURE)
    execute_process(COMMAND "${BINARY}" --failure-probe RESULT_VARIABLE rc
        OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
    if(NOT rc STREQUAL "1" OR NOT err MATCHES "check: argc==0")
        message(FATAL_ERROR "Active-check sentinel failed: rc=${rc}, out=${out}, err=${err}")
    endif()
    return()
endif()
if(NOT DEFINED ENTRY OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "ENTRY and OUTPUT are required")
endif()
file(SHA256 "${ENTRY}" sha)
if(NOT sha STREQUAL "f88e989a41129b764f48374d469801d6014ca6d5b7d35f159b93d6be8328381a")
    message(FATAL_ERROR "Unrecognized task-entry Qwen source")
endif()
file(READ "${ENTRY}" source)
set(begin "        // Jobs in the slots, finished by the runner (on_finish) or, after an engine failure, here.")
set(end "        finished.store(true);\n        watcher.join();")
foreach(anchor IN ITEMS "${begin}" "${end}")
    string(FIND "${source}" "${anchor}" pos)
    if(pos LESS 0)
        message(FATAL_ERROR "Missing extraction anchor")
    endif()
    string(LENGTH "${anchor}" len)
    math(EXPR tail "${pos}+${len}")
    string(SUBSTRING "${source}" ${tail} -1 rest)
    string(FIND "${rest}" "${anchor}" duplicate)
    # The end anchor also appears in the serial route. Select the batched tail
    # only AFTER the unique begin anchor below; never accept duplicate begins.
    if(anchor STREQUAL begin AND NOT duplicate LESS 0)
        message(FATAL_ERROR "Duplicate begin anchor")
    endif()
endforeach()
string(FIND "${source}" "${begin}" start)
string(SUBSTRING "${source}" ${start} -1 tail)
string(FIND "${tail}" "${end}" finish)
if(finish LESS 0)
    message(FATAL_ERROR "Missing batched end anchor")
endif()
string(SUBSTRING "${tail}" 0 ${finish} block)
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
    if(NOT existing STREQUAL block)
        message(FATAL_ERROR "Refusing to overwrite a different entry reference")
    endif()
else()
    # file(WRITE) uses native text newlines on Windows. The pinned entry is
    # UTF-8/LF; preserve its bytes rather than silently translating to CRLF.
    file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${block}" @ONLY NEWLINE_STYLE UNIX)
endif()
string(HEX "${block}" expected_hex)
file(READ "${OUTPUT}" actual_hex HEX)
if(NOT actual_hex STREQUAL expected_hex)
    message(FATAL_ERROR "Extracted reference bytes differ (including newlines)")
endif()
