execute_process(COMMAND "${PROGRAM}" "${MODE}" "${DRIFT}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(MODE STREQUAL "single")
    set(who "prefill")
    set(rank 0)
elseif(MODE STREQUAL "pair0")
    set(who "rank 0")
    set(rank 0)
else()
    set(who "rank 1")
    set(rank 1)
endif()
if(DRIFT STREQUAL "stable")
    if(NOT status STREQUAL "0" OR NOT output MATCHES "${who} repeat digests: 2 runs, equal"
       OR NOT output MATCHES "continuation allowed")
        message(FATAL_ERROR "Stable timing repetitions failed: ${status}\n${output}\n${error}")
    endif()
    set(verdict "${who} repeat digests:")
else()
    if(NOT status STREQUAL "2" OR NOT output MATCHES "${who} REPEAT DIGEST MISMATCH: run 1 .* != run 0"
       OR NOT error MATCHES "REPEAT DIGEST MISMATCH" OR output MATCHES "continuation allowed")
        message(FATAL_ERROR "Timing drift escaped the gate: ${status}\n${output}\n${error}")
    endif()
    set(verdict "${who} REPEAT DIGEST MISMATCH:")
endif()
string(FIND "${output}" "receipt rank ${rank}" receipt_pos)
string(FIND "${output}" "${verdict}" verdict_pos)
if(receipt_pos LESS 0 OR receipt_pos GREATER_EQUAL verdict_pos)
    message(FATAL_ERROR "Receipt must precede verdict: ${output}")
endif()
