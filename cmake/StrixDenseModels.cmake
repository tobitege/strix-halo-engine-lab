include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/StrixWeight.cmake")
# Also usable by the small standalone host-test project, with no HIP/CUDA dependency.
set(strix_dense_root "${CMAKE_CURRENT_LIST_DIR}/..")
if(NOT TARGET strix_serve_json)
    add_library(strix_serve_json STATIC "${strix_dense_root}/src/serve/json.cpp")
    target_include_directories(strix_serve_json PUBLIC "${strix_dense_root}/include")
    target_compile_features(strix_serve_json PUBLIC cxx_std_20)
endif()
if(NOT TARGET strix_model_graph)
    add_library(strix_model_graph STATIC "${strix_dense_root}/src/model_graph/model_graph.cpp")
    target_compile_features(strix_model_graph PUBLIC cxx_std_20)
endif()
target_sources(strix_model_graph PRIVATE "${strix_dense_root}/src/model_graph/dense_adapter.cpp")
target_include_directories(strix_model_graph PUBLIC "${strix_dense_root}/include" "${strix_dense_root}/src")
add_library(strix_weight_archive STATIC
    "${strix_dense_root}/src/core/weight_archive.cpp"
    "${strix_dense_root}/src/core/dense_model_config.cpp"
    "${strix_dense_root}/src/gguf_reader.cpp"
    "${strix_dense_root}/src/ggml_dequant.cpp"
    "${strix_dense_root}/src/iq4_nl.cpp")
target_compile_features(strix_weight_archive PUBLIC cxx_std_20)
target_include_directories(strix_weight_archive PUBLIC "${strix_dense_root}/include")
target_link_libraries(strix_weight_archive PUBLIC strix_serve_json strix-weight)
target_link_libraries(strix_model_graph PUBLIC strix_weight_archive)
add_library(strix_qwen27_model STATIC "${strix_dense_root}/src/qwen27/model.cpp"
    "${strix_dense_root}/src/model_family_registry.cpp")
target_link_libraries(strix_qwen27_model PUBLIC strix_weight_archive strix_model_graph)
foreach(strix_dense_target strix_weight_archive strix_qwen27_model)
    if(MSVC)
        target_compile_options(${strix_dense_target} PRIVATE /W4 /WX /permissive- /fp:strict /utf-8)
    else()
        target_compile_options(${strix_dense_target} PRIVATE -Wall -Wextra -Werror -Wshadow -Wsign-conversion -ffp-contract=off)
    endif()
endforeach()
if(BUILD_TESTING)
    add_executable(strix-qwen27-host-tests "${strix_dense_root}/tests/qwen27_host_tests.cpp")
    target_link_libraries(strix-qwen27-host-tests PRIVATE strix_qwen27_model)
    if(MSVC)
        target_compile_options(strix-qwen27-host-tests PRIVATE /W4 /WX /permissive- /fp:strict)
    else()
        target_compile_options(strix-qwen27-host-tests PRIVATE -Wall -Wextra -Werror -Wshadow -Wsign-conversion)
    endif()
    add_test(NAME strix-qwen27-host-tests COMMAND strix-qwen27-host-tests)
endif()
