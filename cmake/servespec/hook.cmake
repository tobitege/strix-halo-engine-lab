# Serving-spec fragment hook. Included once, at the end of the top-level CMakeLists.txt, so every target of the
# tree is visible. Each cmake/servespec/<name>.cmake fragment registers its own sources and host tests; adding a
# fragment needs no edit to CMakeLists.txt. Fragments are included in name order.
#
# Helpers for fragments (all paths relative to the source root):
#   strix_servespec_serve_sources(<src>...)
#       Adds shared serving sources to strix_serve when that target exists in this configuration.
#   strix_servespec_host_test(NAME <test> SOURCES <src>... [LIBS <target>...] [TIMEOUT <s>])
#       C++20 host test (no GPU). Listed LIBS that are not targets in this configuration skip the test.
#   strix_servespec_python_test(NAME <test> SCRIPT <path> [ARGS <arg>...] [TIMEOUT <s>])
#       Python host test, skipped when no interpreter is found.
# Host tests are registered only under BUILD_TESTING.

function(strix_servespec_serve_sources)
    if(TARGET strix_serve)
        foreach(strix_servespec_source IN LISTS ARGN)
            target_sources(strix_serve PRIVATE "${CMAKE_SOURCE_DIR}/${strix_servespec_source}")
        endforeach()
    endif()
endfunction()

function(strix_servespec_host_test)
    cmake_parse_arguments(arg "" "NAME;TIMEOUT" "SOURCES;LIBS" ${ARGN})
    if(NOT arg_NAME OR NOT arg_SOURCES)
        message(FATAL_ERROR "strix_servespec_host_test needs NAME and SOURCES")
    endif()
    if(NOT BUILD_TESTING)
        return()
    endif()
    foreach(strix_servespec_lib IN LISTS arg_LIBS)
        if(NOT TARGET ${strix_servespec_lib})
            message(STATUS "servespec: ${arg_NAME} skipped (${strix_servespec_lib} is not built here)")
            return()
        endif()
    endforeach()
    set(strix_servespec_paths)
    foreach(strix_servespec_source IN LISTS arg_SOURCES)
        list(APPEND strix_servespec_paths "${CMAKE_SOURCE_DIR}/${strix_servespec_source}")
    endforeach()
    add_executable(${arg_NAME} ${strix_servespec_paths})
    target_include_directories(${arg_NAME} PRIVATE "${CMAKE_SOURCE_DIR}/include")
    target_compile_features(${arg_NAME} PRIVATE cxx_std_20)
    if(arg_LIBS)
        target_link_libraries(${arg_NAME} PRIVATE ${arg_LIBS})
    endif()
    strix_target_warnings(${arg_NAME})
    add_test(NAME ${arg_NAME} COMMAND ${arg_NAME})
    if(NOT arg_TIMEOUT)
        set(arg_TIMEOUT 60)
    endif()
    set_tests_properties(${arg_NAME} PROPERTIES TIMEOUT ${arg_TIMEOUT})
endfunction()

function(strix_servespec_python_test)
    cmake_parse_arguments(arg "" "NAME;SCRIPT;TIMEOUT" "ARGS" ${ARGN})
    if(NOT arg_NAME OR NOT arg_SCRIPT)
        message(FATAL_ERROR "strix_servespec_python_test needs NAME and SCRIPT")
    endif()
    if(NOT BUILD_TESTING)
        return()
    endif()
    find_package(Python3 COMPONENTS Interpreter QUIET)
    if(NOT Python3_Interpreter_FOUND)
        message(STATUS "servespec: ${arg_NAME} skipped (no Python interpreter)")
        return()
    endif()
    add_test(NAME ${arg_NAME}
        COMMAND ${Python3_EXECUTABLE} -B "${CMAKE_SOURCE_DIR}/${arg_SCRIPT}" ${arg_ARGS})
    if(NOT arg_TIMEOUT)
        set(arg_TIMEOUT 120)
    endif()
    set_tests_properties(${arg_NAME} PROPERTIES TIMEOUT ${arg_TIMEOUT})
endfunction()

file(GLOB strix_servespec_fragments CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/*.cmake")
list(SORT strix_servespec_fragments)
foreach(strix_servespec_fragment IN LISTS strix_servespec_fragments)
    get_filename_component(strix_servespec_name "${strix_servespec_fragment}" NAME)
    if(NOT strix_servespec_name STREQUAL "hook.cmake")
        include("${strix_servespec_fragment}")
    endif()
endforeach()
