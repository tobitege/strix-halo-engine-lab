# Shared expert residency planner (strix/residency/expert_residency.hpp): host only, always built.
if(TARGET strix_residency)
    return()
endif()
add_library(strix_residency STATIC ${CMAKE_CURRENT_LIST_DIR}/../src/residency/expert_residency.cpp)
target_include_directories(strix_residency PUBLIC ${CMAKE_CURRENT_LIST_DIR}/../include)
target_compile_features(strix_residency PUBLIC cxx_std_20)
if(COMMAND strix_target_warnings)
    strix_target_warnings(strix_residency)
endif()
if(BUILD_TESTING)
    add_executable(strix-expert-residency-tests ${CMAKE_CURRENT_LIST_DIR}/../tests/expert_residency_tests.cpp)
    target_link_libraries(strix-expert-residency-tests PRIVATE strix_residency)
    if(COMMAND strix_target_warnings)
        strix_target_warnings(strix-expert-residency-tests)
    endif()
    add_test(NAME strix-expert-residency-tests COMMAND strix-expert-residency-tests)
endif()
